<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(PolynomialTools):

IA := diff(ax(t2), t2) = -2/3*(((5*(dv+2*gv))*((-4/3*(alpha^2)+11/15*alpha-1/3)*gv^3+((-4/3*(alpha^2)+11/15*alpha-1/3)*dv-(11/15*gvv)*alpha+2/3*gvv)*gv^2+((alpha^2-11/20*alpha+1/4)*dv^2-(31/30*gvv)*(alpha-23/31)*dv-14/15*(gvv^2))*gv+(3/10*dv)*((alpha-1/2)*dv-34/9*gvv)*gvv)*ax(t2)^3/((3*dv+2*gv)*(dv^2-4*gv^2))-(1/12)*((18*(dv+2/3*gv))*(dv+2*gv)*(dv-2*gv)*L2*gv*sqrt(2)+(72*(dv+2/3*gv))*bx(t2)^2*((-4*alpha^2+7*alpha-1)*gv^3+(-7*alpha*gvv+2*gvv)*gv^2+((alpha^2-7/4*alpha+1/4)*dv^2+(3/2*gvv)*(alpha-1/3)*dv+2*gvv^2)*gv+(3/2*((alpha-1/2)*dv+2/3*gvv))*dv*gvv)*Pi)*ax(t2)/(Pi*(3*dv+2*gv)*(dv^2-4*gv^2)))*(3*dv+2*gv)*(dv^2-4*gv^2)/((dv+2*gv-1)*(dv+2/3*gv)*(dv+2*gv)*(dv-2*gv)));
IB := diff(bx(t2), t2) = -2/3*(((5*(dv+2*gv))*((-4/3*(alpha^2)+11/15*alpha-1/3)*gv^3+((-4/3*(alpha^2)+11/15*alpha-1/3)*dv-(11/15*gvv)*alpha+2/3*gvv)*gv^2+((alpha^2-11/20*alpha+1/4)*dv^2-(31/30*gvv)*(alpha-23/31)*dv-14/15*(gvv^2))*gv+(3/10*dv)*((alpha-1/2)*dv-34/9*gvv)*gvv)*bx(t2)^3/((3*dv+2*gv)*(dv^2-4*gv^2))-(1/12)*((18*(dv+2/3*gv))*(dv+2*gv)*(dv-2*gv)*L2*gv*sqrt(2)+72*ax(t2)^2*(dv+2/3*gv)*((-4*alpha^2+7*alpha-1)*gv^3+(-7*alpha*gvv+2*gvv)*gv^2+((alpha^2-7/4*alpha+1/4)*dv^2+(3/2*gvv)*(alpha-1/3)*dv+2*gvv^2)*gv+(3/2*((alpha-1/2)*dv+2/3*gvv))*dv*gvv)*Pi)*bx(t2)/(Pi*(3*dv+2*gv)*(dv^2-4*gv^2)))*(3*dv+2*gv)*(dv^2-4*gv^2)/((dv+2*gv-1)*(dv+2/3*gv)*(dv+2*gv)*(dv-2*gv)));</Text-field>
</Input>
