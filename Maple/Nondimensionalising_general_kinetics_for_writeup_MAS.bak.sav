<Group hide-input="false" labelreference="L8" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
pu:=v0*fv/fu;
pv:=v0;
pt:=1/fu;
u:=pu*U;
v:=pv*V;
t:=pt*T;

F:=(u-u0)*u*v*fu/(u0*v0)+(v-v0)*u*v*fv/(u0*v0):
G:=(u-u0)*u*v*gu/(u0*v0)+(v-v0)*u*v*gv/(u0*v0):

J:=subs({U=u0/pu,V=v0/pv},Matrix([[ diff(F*pt/pu,U) , diff(F*pt/pu,V) ],
        [ diff(G*pt/pv,U) , diff(G*pt/pv,V) ]]));
simplify(subs({isolate(alpha=v0*fv/(fu*u0),v0),gu=ff*fu^2/fv,gv=gg*fu},F*pt/pu)-(U*alpha-1)*U*V-alpha*(V-1)*U*V);
simplify(subs({isolate(alpha=v0*fv/(fu*u0),v0),gu=ff*fu^2/fv,gv=gg*fu},G*pt/pv)-(U*alpha-1)*ff*U*V-alpha*(V-1)*U*V*gg);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">KihJI3YwRzYiIiIiSSNmdkdGJEYlSSNmdUdGJCEiIg==</Equation></Text-field>
</Output>
