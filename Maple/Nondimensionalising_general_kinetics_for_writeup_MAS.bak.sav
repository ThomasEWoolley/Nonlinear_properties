<Group hide-input="false" labelreference="L11" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">pu:=solve(J[1,2]=1,Cu)*u0;
pv:=Cv*v0;
pt:=1/fu;
u:=pu*U;
v:=pv*V;
t:=pt*T;

F:=(u-u0)*u*v*fu/(u0*v0)+(v-v0)*u*v*fv/(u0*v0):
G:=(u-u0)*u*v*gu/(u0*v0)+(v-v0)*u*v*gv/(u0*v0):


J:=subs({U=u0/pu,V=v0/pv},Matrix([[ diff(F*pt/pu,U) , diff(F*pt/pu,V) ],
        [ diff(G*pt/pv,U) , diff(G*pt/pv,V) ]]));


</Text-field>
</Input>
