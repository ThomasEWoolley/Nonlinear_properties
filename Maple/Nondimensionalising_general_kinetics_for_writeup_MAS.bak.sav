<Group hide-input="false" labelreference="L12" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">
subs(isolate(alpha=v0*fv/(fu*u0),v0),F*pt/pu);
simplify(((Cv*U*alpha*u0-u0)*Cv^2*alpha*fu*U*V)/(Cv*alpha*fu*u0));
simplify(((Cv*alpha*fu*u0*V/fv-alpha*fu*u0/fv)*Cv^2*alpha*fv*U*V)/(Cv*alpha*fu*u0));


subs({isolate(alpha=v0*fv/(fu*u0),v0),gu=ff*fu^2/fv,gv=gg*fu},G*pt/pv);
simplify(coeff(%,ff));
simplify(coeff(%%,gg));</Text-field>
</Input>
