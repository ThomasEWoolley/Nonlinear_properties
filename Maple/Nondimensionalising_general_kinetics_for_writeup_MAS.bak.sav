<Task/>
<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:

#fu:=1;fv:=1;gu:=-3;gv:=-2;Du:=1;Dv:=10;
F:=(u-u0)*u*v*fu/(u0*v0)+(v-v0)*u*v*fv/(u0*v0):
G:=(u-u0)*u*v*gu/(u0*v0)+(v-v0)*u*v*gv/(u0*v0):

J:=subs({u=u0,v=v0},Matrix([[ diff(F,u) , diff(F,v) ],
        [ diff(G,u) , diff(G,v) ]]));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LUknTWF0cml4RzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiNiMvSSQlaWRHRiciNSEqZih6R0hudVklPQ==</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
pu:=Cu*u0;
pv:=Cv*v0;
pt:=Ct;
u:=pu*U;
v:=pv*V;
t:=pt*T;

F:=(u-u0)*u*v*fu/(u0*v0)+(v-v0)*u*v*fv/(u0*v0):
G:=(u-u0)*u*v*gu/(u0*v0)+(v-v0)*u*v*gv/(u0*v0):

F*pt/cu;
G*pt/cv;

J:=subs({U=u0/pu,V=v0/pv},Matrix([[ diff(F*pt/pu,U) , diff(F*pt/pu,V) ],
        [ diff(G*pt/pu,U) , diff(G*pt/pu,V) ]]));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">KiZJI0N1RzYiIiIiSSN1MEdGJEYl</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">KiZJI0N2RzYiIiIiSSN2MEdGJEYl</Equation></Text-field>
</Output>
