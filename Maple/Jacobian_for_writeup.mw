<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):


F:=(u-u0)*u*v*f1(u,v)+(v-v0)*u*v*f2(u,v):
G:=(u-u0)*u*v*g1(u,v)+(v-v0)*u*v*g2(u,v):
<Equation executable="true" style="2D Input" input-equation="" display=""></Equation>
J:=subs({u=u0,v=v0},Matrix([[ diff(F,u) , diff(F,v) ],
        [ diff(G,u) , diff(G,v) ]]));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
