<Group hide-input="false" labelreference="L2375" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#First order linear operator

L1:=unapply(convert(coeff(series(EQ1,epsilon,4),epsilon),diff),(u1,v1)):
L2:=unapply(convert(coeff(series(EQ2,epsilon,4),epsilon),diff),(u1,v1)):
L1T:=unapply(subs({diff(F(u0, v0), v0)=diff(G(u0, v0), u0)},L1(u1,v1)),(u1,v1)):
L2T:=unapply(subs({diff(G(u0, v0), u0)=diff(F(u0, v0), v0)},L2(u1,v1)),(u1,v1)):


L1(u1,v1);
L2(u1,v1);
L1T(u1,v1);
L2T(u1,v1);</Text-field>
</Input>
