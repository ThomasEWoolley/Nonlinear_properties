eval(subs(base,S[3])):
LcAlg:=simplify(subs(Stst,%));
Lc:=evalf(subs(Stst,%));

Vector[column]([ subs(l[c]=Lc,subs(Stst,eval(subs(base,lambda)))) , 1 ]);



