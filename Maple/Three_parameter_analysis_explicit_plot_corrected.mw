Subber3:={u2(x, t[2])=sum(cu[2*n](t[2])*cos(Pi*(2*n)*x),n=0..1),v2(x, t[2])=sum(cv[2*n](t[2])*cos(Pi*(2*n)*x),n=0..1)}:

convert(L1(u3,v3)-coeff(series(EQ1,epsilon,5),epsilon^3),diff):
Lu3:=simplify(subs({op(Subber),op(Subber3)},%)):
convert(L2(u3,v3)-coeff(series(EQ2,epsilon,5),epsilon^3),diff):
Lv3:=simplify(subs({op(Subber),op(Subber3)},%)):
SolvabilityCriterion2:=simplify(int((Lu3*eta+Lv3)*cos(Pi*x),x=0..1));


subs({Eta=eta,Lambda=lambda},%):
#subs(l[c]=LcAlg,%):
simplify(expand(simplify(subs(Stst,eval(subs(base,%)))))):
simplify(expand(subs(CoeffsNum,%))):

#collect(isolate(%,diff(a(t[2]), t[2])),a);
Pitch:=collect(isolate(eval(%),diff(a(t[2]), t[2])),a,simplify);
