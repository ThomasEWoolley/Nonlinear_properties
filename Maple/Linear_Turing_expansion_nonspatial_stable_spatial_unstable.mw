<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):
(*
Paras:={Gu=2,Gv=1,du=1,dv=2};
#F:=(u(x,t)-1)+(v(x,t)-1):
#G:=-(u(x,t)-1)*Gu-(v(x,t)-1)*Gv:

F:=(u(x,t)-a)*u(x,t)/a+(v(x,t)-b)*u(x,t)/a:
G:=-(u(x,t)-a)*v(x,t)/b*gu-(v(x,t)-b)*v(x,t)/b*gv:

F:=(u(x,t)-1)*u(x,t)+(v(x,t)-1)*u(x,t):
G:=-(u(x,t)-1)*v(x,t)*gu-(v(x,t)-1)*v(x,t)*gv:
*)

F:=(u(x,t)-1)*u(x,t)+(v(x,t)-1)*u(x,t):
G:=-(u(x,t)-1)*v(x,t)*2.2-(v(x,t)-1)*v(x,t)*(2):

F:=(u(x,t)-1)*u(x,t)*v(x,t)+(v(x,t)-1)*u(x,t)*v(x,t):
G:=-(u(x,t)-1)*v(x,t)*2.2*u(x,t)-(v(x,t)-1)*v(x,t)*(2)*u(x,t):


EQ1:=diff(u(x,t),x,x)+F-diff(u(x,t),t):
EQ2:=dv*diff(v(x,t),x,x)+G-diff(v(x,t),t):


Pert:=exp(lambda*t)*cos(k*x):
u(x,t):=u0+eu*Pert:
v(x,t):=v0+ev*Pert:

uM:=mtaylor(EQ1,[eu,ev],2);
vM:=mtaylor(EQ2,[eu,ev],2);

Stst:=solve([coeff(coeff(uM,eu,0),ev,0),coeff(coeff(vM,eu,0),ev,0)],{u0,v0});
Stst:=Stst[3];

diffstst:=subs(Stst,[uM,vM]):

J:=Matrix([[ coeff(diffstst[1],eu) , coeff(diffstst[1],ev) ],
        [ coeff(diffstst[2],eu) , coeff(diffstst[2],ev) ]]);
DetJ:=collect(Determinant(J)/Pert^2,lambda,factor);
C:=collect(subs(lambda=0,DetJ),k);</Text-field>
</Input>
