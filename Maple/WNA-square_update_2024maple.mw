<Group hide-input="false" labelreference="L35" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">E1u:=convert(coeff(series(Eq1,epsilon,4),epsilon,1),diff);
