<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):
#YY:=0;
L:=Lc+epsilon^2*L2:
Eq1:=-(diff(u(x,y,t2),t2)*epsilon^2)+1/(L^2)*(diff(u(x,y,t2),x,x)+diff(u(x,y,t2),y,y))+f(u(x,y,t2),v(x,y,t2));
Eq2:=-(diff(v(x,y,t2),t2)*epsilon^2)+dv/(L^2)*(diff(v(x,y,t2),x,x)+diff(v(x,y,t2),y,y))+g(u(x,y,t2),v(x,y,t2));

u(x,y,t2):=u+u1(x,y,t2)*epsilon+u2(x,y,t2)*epsilon^2+u3(x,y,t2)*epsilon^3:
v(x,y,t2):=v+v1(x,y,t2)*epsilon+v2(x,y,t2)*epsilon^2+v3(x,y,t2)*epsilon^3:

#f:=(u,v)-&gt;a-u+u^2*v; g:=(u,v)-&gt;b-u^2*v; a:=1/10; b:=9/10; du:=1; dv:=10;

f:=(u,v)-&gt;(u*alpha-1)*u*v+alpha*(v-1)*u*v:
g:=(u,v)-&gt;-(u*alpha-1)*v*u*((1/4)*dv+(1/2)*gv)-alpha*(v-1)*v*u*gv+gvv*alpha*(v-1)^2*v*u:</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L33" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">E0u:=coeff(series(Eq1,epsilon,4),epsilon,0);
E0v:=coeff(series(Eq2,epsilon,4),epsilon,0);

SS:=solve({E0u,E0v},{u,v});
SS:=SS[3];
</Text-field>
</Input>
