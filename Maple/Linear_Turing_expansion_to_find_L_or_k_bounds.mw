<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):
Paras:={gu=3,gv=2,dv=10}:
F:=(u,v)-&gt;(u*alpha-1)*u*v+alpha*(v-1)*u*v:
G:=(u,v)-&gt;-(u*alpha-1)*v*u*gu-alpha*(v-1)*v*u*gv:


EQ1:=diff(u(x,t),x,x)+F(u(x,t),v(x,t))-diff(u(x,t),t):
EQ2:=dv*diff(v(x,t),x,x)+G(u(x,t),v(x,t))-diff(v(x,t),t):


Pert:=exp(lambda*t)*cos(k*x):
u(x,t):=1/alpha+eu*Pert:
v(x,t):=1+ev*Pert:

uM:=mtaylor(EQ1,[eu,ev],2);
vM:=mtaylor(EQ2,[eu,ev],2);


diffstst:=[uM,vM];

J:=convert(Matrix([[ coeff(diffstst[1],eu) , coeff(diffstst[1],ev) ],
        [ coeff(diffstst[2],eu) , coeff(diffstst[2],ev) ]])/Pert,diff);
DetJ:=collect(Determinant(J),lambda,factor);
C:=collect(subs(lambda=0,DetJ),k);</Text-field>
</Input>
