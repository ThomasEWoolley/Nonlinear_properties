<Group hide-input="false" labelreference="L16" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):

F:=(u(x,t)-1)+(v(x,t)-1):
G:=-(u(x,t)-1)*Gu-(v(x,t)-1)*Gv:

EQ1:=du*diff(u(x,t),x,x)/L^2+F-diff(u(x,t),t):
EQ2:=dv*diff(v(x,t),x,x)/L^2+G-diff(v(x,t),t):


Pert:=exp(lambda*t)*cos(k*Pi*x):
u(x,t):=u0+eu*Pert:
v(x,t):=v0+ev*Pert:

uM:=mtaylor(EQ1,[eu,ev],2);
vM:=mtaylor(EQ2,[eu,ev],2);

Stst:=solve([coeff(coeff(uM,eu,0),ev,0),coeff(coeff(vM,eu,0),ev,0)],{u0,v0});

diffstst:=subs(Stst,[uM,vM]):

J:=Matrix([[ coeff(diffstst[1],eu) , coeff(diffstst[1],ev) ],
        [ coeff(diffstst[2],eu) , coeff(diffstst[2],ev) ]]);
DetJ:=collect(Determinant(J),lambda,factor);

#Routh-Hurwitz condition...the system is stable is both all terms are positive.
#Since coeff of lambda is positive, the only way to get instability is if the constant term in negative.

DispersionRoots:=solve(subs(k=sqrt(y),simplify(subs(lambda=0,DetJ/Pert^2))),y);
isolate(DispersionRoots[1]=1,L);
Lc:=solve(DispersionRoots[1]=1,L);
evalf(Lc);</Text-field>
</Input>
