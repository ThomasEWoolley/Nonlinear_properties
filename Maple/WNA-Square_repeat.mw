<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Subbed1:={u1(x,y,t2)=ax(t2)*Ux*cos(x*k),v1(x,y,t2)=ax(t2)*Vx*cos(x*k)}:
collect(series(collect(simplify(expand(subs(Subbed1,Eq1))),epsilon),epsilon,3),[epsilon,Ux,Vx]):
subs(epsilon=0,subs(SS,%));

C1:=collect(coeff(%%,epsilon)/(ax(t2)*cos(x*k)),[Ux,Vx],simplify);

collect(series(collect(simplify(expand(subs(Subbed1,Eq2))),epsilon),epsilon,3),[epsilon,Ux,Vx]):
simplify(subs(epsilon=0,subs(SS,%)));

C2:=collect(coeff(%%,epsilon)/(ax(t2)*cos(x*k)),[Ux,Vx],simplify);

M:=Matrix([[ coeff(C1,Ux) , coeff(C1,Vx) ],        [ coeff(C2,Ux) , coeff(C2,Vx) ]]);
LS:=[solve(subs(k=Pi,subs(SS,collect(Determinant(M),Lc))),Lc)];
subs({du=1,dv=10,gv=2},%);
evalf(%);
lc:=LS[1];
Vecnull:=simplify(subs(k=Pi,subs(SS,simplify(subs(Lc=lc,M))).Vector[column]([ Lambda ,                 1 ])));
solve(Vecnull[1],Lambda);
solve(Vecnull[2],Lambda);
subs({dv=10,gv=2},%);

VecnullT:=simplify(Transpose(subs(k=Pi,subs(SS,simplify(subs(Lc=lc,M))))).Vector[column]([ Eta ,
                 1 ]));
solve(VecnullT[1],Eta);
solve(VecnullT[2],Eta);
