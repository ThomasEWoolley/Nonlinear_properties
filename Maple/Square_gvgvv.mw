<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):

L:=Lc+epsilon^2*L2:
Eq1:=-(diff(u(x,y,t2),t2)*epsilon^2)+1/(L^2)*(diff(u(x,y,t2),x,x)+diff(u(x,y,t2),y,y))+f(u(x,y,t2),v(x,y,t2));
Eq2:=-(diff(v(x,y,t2),t2)*epsilon^2)+10/(L^2)*(diff(v(x,y,t2),x,x)+diff(v(x,y,t2),y,y))+g(u(x,y,t2),v(x,y,t2));

u(x,y,t2):=u+u1(x,y,t2)*epsilon+u2(x,y,t2)*epsilon^2+u3(x,y,t2)*epsilon^3:
v(x,y,t2):=v+v1(x,y,t2)*epsilon+v2(x,y,t2)*epsilon^2+v3(x,y,t2)*epsilon^3:


f:=(u,v)-&gt;(u-1)*u*v+(v-1)*u*v:
g:=(u,v)-&gt;-(u-1)*v*u*((1/4)*10+(1/2)*gv)-(v-1)*v*u*gv+gvv*(v-1)^2*v*u:</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">E0u:=coeff(series(Eq1,epsilon,4),epsilon,0);
E0v:=coeff(series(Eq2,epsilon,4),epsilon,0);

SS:=solve({E0u,E0v},{u,v});
SS:=SS[3];

E1u:=convert(coeff(series(Eq1,epsilon,4),epsilon,1),diff);
E1v:=convert(coeff(series(Eq2,epsilon,4),epsilon,1),diff);

Lu:=unapply(E1u,[u1,v1]);
Lv:=unapply(E1v,[u1,v1]);

Subbed1:={u1(x,y,t2)=ax(t2)*Ux*cos(x*k)+YY*ax(t2)*Uy*cos(y*k),v1(x,y,t2)=ax(t2)*Vx*cos(x*k)+YY*ax(t2)*Vy*cos(y*k)}:

subs(Subbed1,Lu(u1,v1));
subs({Ux=(- ax(t2)*Uy*cos(y*k)+subber1)/(ax(t2)*cos(x*k)),Vx=(- ax(t2)*Vy*cos(y*k)+subber2)/(ax(t2)*cos(x*k))},%):
CE1u:=collect(%,{subber1,subber2},simplify):

subs(Subbed1,Lv(u1,v1));
subs({Ux=(- ax(t2)*Uy*cos(y*k)+subber1)/(ax(t2)*cos(x*k)),Vx=(- ax(t2)*Vy*cos(y*k)+subber2)/(ax(t2)*cos(x*k))},%):
CE1v:=collect(%,{subber1,subber2},simplify):



M:=Matrix([[ coeff(CE1u,subber1) , coeff(CE1u,subber2) ],
        [ coeff(CE1v,subber1) , coeff(CE1v,subber2) ]]);
det:=Determinant(M):
solve(subs(SS,subs(k=Pi,%)),Lc):

solve(subs(SS,subs(Lc=sqrt(Lc2),subs(k=Pi,det))),Lc2):
lc:=sqrt(%[1]);

Lam:=Vector[column]([ Lambda ,
                 1 ]):
Et:=Vector[column]([ Eta ,
                 1 ]):
</Text-field>
</Input>
