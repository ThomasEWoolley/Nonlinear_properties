FTcoeffsv:=collect(combine(simplify(subs(Subber2,S2)),trig),cos,simplify):

collect(subs(l[c]=LcAlg,subs(Stst,eval(subs(base,FTcoeffsu)))),cos,simplify);
</Text-field>
