<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):
with(ArrayTools):

#Expansion variables
u(x,t[1],t[2]):=u0+epsilon*u1(x,t[1],t[2])+epsilon^2*u2(x,t[1],t[2])+epsilon^3*u3(x,t[1],t[2]):
v(x,t[1],t[2]):=v0+epsilon*v1(x,t[1],t[2])+epsilon^2*v2(x,t[1],t[2])+epsilon^3*v3(x,t[1],t[2]):
L:=l[c]+epsilon*l[1]+epsilon^2*l[2]:

#General RD equations
EQ1:=du*diff(u(x,t[1],t[2]),x,x)/L^2+F(u(x,t[1],t[2]),v(x,t[1],t[2]))-epsilon*diff(u(x,t[1],t[2]),t[1])-epsilon^2*diff(u(x,t[1],t[2]),t[2]);
EQ2:=dv*diff(v(x,t[1],t[2]),x,x)/L^2+G(u(x,t[1],t[2]),v(x,t[1],t[2]))-epsilon*diff(v(x,t[1],t[2]),t[1])-epsilon^2*diff(v(x,t[1],t[2]),t[2]):

#Fsch:=(u,v)-&gt;(u-1)+(v-1):
#Gsch:=(u,v)-&gt;-(u-1)*2-(v-1)*1:

Fsch:=(u,v)-&gt;(u-a)*u/a+(v-b)*u/a:
Gsch:=(u,v)-&gt;-(u-a)*v/b*gu-(v-b)*v/b*gv:


base:={F=Fsch,G=Gsch}:
Params:={du=1/1000,dv=1/10}:
baseparams:={F=Fsch,G=Gsch,du=1/1000,dv=1/10}:
</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Set steady state
C1:=coeff(series(EQ1,epsilon,4),epsilon,0)=0;
C2:=coeff(series(EQ2,epsilon,4),epsilon,0)=0;

Stst:=solve(eval(subs(base,{C1,C2})),{u0,v0});

Stst:=Stst[4];
</Text-field>
</Input>
