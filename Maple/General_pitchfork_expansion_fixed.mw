<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Generate eigenvalue
Subber:={u1(x,t[1],t[2])=u1*cos(Pi*x),v1(x,t[1],t[2])=cos(Pi*x)}:
S1:=subs(Subber,L1(u1,v1));
S2:=subs(Subber,L2(u1,v1)):
lambda:=solve(S1,u1);

Eiger:={u1(x,t[1],t[2])=Lambda*cos(Pi*x),v1(x,t[1],t[2])=cos(Pi*x)}:
simplify(subs(u1=lambda,S2));

