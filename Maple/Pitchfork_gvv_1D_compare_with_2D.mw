<Group hide-input="false" labelreference="L2376" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># THE ABOVE SHOWS THERE IS NO t[1] DEPENDENCE AND l[1]=0. Although in the linear case the exponential growth would be correct, we use nonlinear terms to restrict the growth.
restart:
with(LinearAlgebra):
with(ArrayTools):
with(PolynomialTools):
with(plots):

#Expansion variables
u(x,t[2]):=u0+epsilon*u1(x,t[2])+epsilon^2*u2(x,t[2])+epsilon^3*u3(x,t[2]):
v(x,t[2]):=v0+epsilon*v1(x,t[2])+epsilon^2*v2(x,t[2])+epsilon^3*v3(x,t[2]):
L:=l[c]+epsilon^2*l[2]:

#General RD equations
EQ1:=diff(u(x,t[2]),x,x)/L^2+F(u(x,t[2]),v(x,t[2]))-epsilon^2*diff(u(x,t[2]),t[2]);
EQ2:=dv*diff(v(x,t[2]),x,x)/L^2+G(u(x,t[2]),v(x,t[2]))-epsilon^2*diff(v(x,t[2]),t[2]):

(*
Fsch:=(u,v)-&gt;(u*alpha-1)*u*v+alpha*(v-1)*u*v:
Gsch:=(u,v)-&gt;-(u*alpha-1)*v*u*((1/4)*dv+(1/2)*gv)-alpha*(v-1)*v*u*gv-(-alpha*gu+alpha*gv)*(v-1)^2*v*u:
#Doesn't produce a subcritical*)

Fsch:=(u,v)-&gt;(u*alpha-1)*u*v+alpha*(v-1)*u*v:
Gsch:=(u,v)-&gt;-(u*alpha-1)*v*u*((1/4)*dv+(1/2)*gv)-alpha*(v-1)*v*u*gv+gvv*alpha*(v-1)^2*v*u:

#assume(gu&gt;0,gv&gt;0,dv&gt;0);
assume(dv&gt;2*gv,gv&gt;0);
base:={F=Fsch,G=Gsch}:




</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L2378" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Set steady state
C1:=coeff(series(EQ1,epsilon,4),epsilon,0)=0;
C2:=coeff(series(EQ2,epsilon,4),epsilon,0)=0:

Stst:=solve(eval(subs(base,{C1,C2})),{u0,v0});
Stst:=Stst[3];
</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">Ly1JIkZHNiI2JEkjdTBHRiVJI3YwR0YlIiIh</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
