<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(LinearAlgebra):
with(ArrayTools):
with(PolynomialTools):
with(plots):

p:=exp(lambda*t[2])*cos(k*x):
#Expansion variables
u(x,t[2]):=1/alpha+e1*p:
v(x,t[2]):=1+e2*p:

#General RD equations
EQ1:=diff(u(x,t[2]),x,x)/L^2+F(u(x,t[2]),v(x,t[2]))-diff(u(x,t[2]),t[2]);
EQ2:=dv*diff(v(x,t[2]),x,x)/L^2+G(u(x,t[2]),v(x,t[2]))-diff(v(x,t[2]),t[2]):


F:=(u,v)-&gt;(u*alpha-1)*u*v+alpha*(v-1)*u*v:
G:=(u,v)-&gt;-(u*alpha-1)*v*u*gu-alpha*(v-1)*v*u*gv:



</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" spaceabove="0" linebreak="space" rightmargin="0" linespacing="0.0" initial="0" firstindent="0" leftmargin="0" bulletsuffix="" alignment="left" bullet="none" spacebelow="0" pagebreak-before="false">S:=solve([F(u,v),G(u,v)],[u,v]);

J:=subs(S[3],Matrix([[ diff(F(u,v),u) , diff(F(u,v),v) ],
        [ diff(G(u,v),u) , diff(G(u,v),v) ]]));
Full:=-k^2/L^2*Matrix([[ 1 , 0 ],        [ 0 , dv ]])+J-Matrix([[ lambda , 0 ],
        [ 0 , lambda ]]);

Determinant(Full);
Elambda:=collect(%,[lambda,k],simplify);
Slambda:=[solve(subs(k=0,Elambda),lambda)];
simplify(subs(k=0,coeff(Elambda,lambda,1))&gt;0);
simplify(subs(k=0,coeff(Elambda,lambda,0))&gt;0);
#Slambda[2];
#solve(Slambda[2]&lt;0);
</Text-field>
</Input>
