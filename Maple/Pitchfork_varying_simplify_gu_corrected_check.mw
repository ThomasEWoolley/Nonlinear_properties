<Group hide-input="false" labelreference="L2374" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Solve for u2
K:=5:
unassign('n');
Subber2:={u2(x, t[2])=sum(cu[n](t[2])*cos(Pi*n*x),n=0..K),v2(x, t[2])=sum(cv[n](t[2])*cos(Pi*n*x),n=0..K)}:

S1:=collect(combine(convert(simplify(subs(Subber,coeff(series(EQ1,epsilon,4),epsilon^2))),diff),trig),cos,simplify):
S2:=collect(combine(convert(simplify(subs(Subber,coeff(series(EQ2,epsilon,4),epsilon^2))),diff),trig),cos,simplify):
#collect(combine(simplify(subs(Subber2,S1)),trig),cos,simplify);
FTcoeffsu:=collect(combine(simplify(subs(Subber2,S1)),trig),cos,simplify):
FTcoeffsv:=collect(combine(simplify(subs(Subber2,S2)),trig),cos,simplify):

Dummyu:=FTcoeffsu:
Dummyv:=FTcoeffsv:
for n from 1 to K do:
Dummyu:=coeff(Dummyu,cos(n*Pi*x),0);
Dummyv:=coeff(Dummyv,cos(n*Pi*x),0);
end:

Uterms:=[Dummyu,seq(coeff(FTcoeffsu,cos(n*Pi*x)),n=1..K)]:
Vterms:=[Dummyv,seq(coeff(FTcoeffsv,cos(n*Pi*x)),n=1..K)]:
Coeffs:=[]:

for n from 1 to K+1 do:
C:=op(solve({Uterms[n],Vterms[n]},[cu[n-1](t[2]),cv[n-1](t[2])]));
Coeffs:=[op(Coeffs),op(C)]:
end:
unassign('n');

simplify(Coeffs);
subs({Eta=eta,Lambda=lambda},Coeffs):
subs(l[c]=LcAlg,%):
CoeffsNum:=simplify(expand(simplify(subs(Stst,eval(subs(base,%))))),symbolic);
#evalf(%);</Text-field>
</Input>
