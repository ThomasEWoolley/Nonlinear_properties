<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
#Lambda
Pars:={dv=10,gu=3,gv=2,alpha=2,gvv=1};

#From 1D
A:=-l[c]^2/(-Pi^2 + l[c]^2):
A:=subs(l[c]=sqrt(2)*Pi*sqrt((-gv + gu)*(-sqrt(dv^2 + (-4*gu + 2*gv)*dv + gv^2) + dv - gv))/(-2*gv + 2*gu),A):

#From 2D
B:=(-sqrt(dv^2 + (-4*gu + 2*gv)*dv + gv^2) - dv + gv)/(sqrt(dv^2 + (-4*gu + 2*gv)*dv + gv^2) + dv - 2*gu + gv):

simplify(A-B);
evalf(simplify(subs(Pars,%)));</Text-field>
</Input>
